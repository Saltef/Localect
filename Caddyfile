# Automatic HTTPS for Localect. Caddy obtains and renews the certificate for
# LOCALECT_DOMAIN and forwards everything to the app with the client's address.
{$LOCALECT_DOMAIN} {
    encode gzip
    reverse_proxy localect:8765 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote_host}
    }
}
